<!-- Package List Component -->
<!-- This component is loaded dynamically to isolate reactivity issues -->
<template id="package-list-component">
    <!-- Ensure consistent order: apk, apt, npm, pypi, go -->
    <template x-for="type in ['apk', 'apt', 'npm', 'pypi', 'go']" :key="type">
        <div x-show="packageTree && packageTree[type] !== undefined" class="mb-2" :data-type="type">
                <!-- Type Header (Collapsible) -->
                <button 
                    @click.prevent="toggleType(type)"
                    type="button"
                    class="w-full flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors text-left">
                    <div class="flex items-center space-x-3">
                        <i :class="getTypeIcon(type)" class="icon text-gray-600"></i>
                        <span class="font-semibold text-gray-900 capitalize" x-text="type"></span>
                        <span class="text-sm text-gray-500" x-text="`(${(packageTree[type] && packageTree[type].count) || 0} packages)`"></span>
                    </div>
                    <i :class="expandedTypes[type] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400"></i>
                </button>
                
                <!-- Groups (for APT) or Packages (Nested) -->
                <!-- Only show when type is explicitly expanded (default: collapsed) -->
                <div x-show="expandedTypes && expandedTypes[type] === true" x-cloak class="ml-4 mt-2 space-y-1">
                    <!-- First, render nested hierarchy (groups) for all types (exclude "default" which is rendered in flat structure) -->
                    <!-- Sort groups alphabetically to ensure consistent ordering (not just Object.entries order) -->
                    <template x-for="groupKey in Object.keys((packageTree[type] && packageTree[type].groups) || {}).sort((a, b) => a.localeCompare(b))" :key="groupKey">
                        <div x-show="groupKey !== 'default' && packageTree[type] && packageTree[type].groups && packageTree[type].groups[groupKey] && ((packageTree[type].groups[groupKey].groups && Object.keys(packageTree[type].groups[groupKey].groups).length > 0) || (packageTree[type].groups[groupKey].packages && Object.keys(packageTree[type].groups[groupKey].packages).length > 0))" x-cloak>
                            <div x-data="{ groupData: packageTree[type] && packageTree[type].groups ? packageTree[type].groups[groupKey] : {}, groupPath: groupKey, depth: 0, getGroupColors: function(depth) {
                            const bgColors = ['bg-purple-100', 'bg-blue-200', 'bg-cyan-200', 'bg-teal-200', 'bg-green-200'];
                            const hoverColors = ['hover:bg-purple-200', 'hover:bg-blue-300', 'hover:bg-cyan-300', 'hover:bg-teal-300', 'hover:bg-green-300'];
                            const textColors = ['text-purple-700', 'text-indigo-700', 'text-cyan-800', 'text-teal-800', 'text-green-800'];
                            const iconColors = ['text-purple-600', 'text-blue-700', 'text-cyan-700', 'text-teal-700', 'text-green-700'];
                            const d = Math.min(depth, bgColors.length - 1);
                            return {
                                bgColor: bgColors[d] || 'bg-gray-100',
                                hoverColor: hoverColors[d] || 'hover:bg-gray-200',
                                textColor: textColors[d] || 'text-gray-700',
                                iconColor: iconColors[d] || 'text-gray-600'
                            };
                        } }">
                            <button 
                                @click.prevent="toggleGroup(type, groupPath)"
                                type="button"
                                :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(depth).bgColor} ${getGroupColors(depth).hoverColor} rounded transition-colors text-left mb-1`">
                                <div class="flex items-center space-x-2">
                                    <i :class="expandedGroups[`${type}:${groupPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" :class="`icon ${getGroupColors(depth).iconColor} text-xs`"></i>
                                    <span :class="`text-xs font-medium ${getGroupColors(depth).textColor}`" x-text="type === 'go' ? formatGoPackageName(groupKey, type) : groupKey"></span>
                                    <span :class="`text-xs ${getGroupColors(depth).iconColor}`" x-text="`(${groupData.count || 0} packages)`"></span>
                                </div>
                            </button>
                            <div x-show="expandedGroups[`${type}:${groupPath}`] === true" x-cloak class="ml-2">
                                <!-- First, render packages if they exist -->
                                <!-- For Go packages, also render packages that have nested packages (sub-packages) -->
                                <div x-show="groupData.packages && Object.keys(groupData.packages).length > 0">
                                    <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                        <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                            <!-- Package button - show versions if it has them, or sub-packages if it has those -->
                                            <button 
                                                @click.prevent="togglePackage(type, pkgGroup.fullName || `${groupPath}/${pkgName}`)"
                                                type="button"
                                                class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                <div class="flex items-center space-x-2 flex-1">
                                                    <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                    <!-- Show version count if package has versions, or sub-package count if it has sub-packages -->
                                                    <span class="text-xs text-gray-500" x-text="(() => { 
                                                        const hasVersions = pkgGroup.versions && pkgGroup.versions.length > 0;
                                                        const hasSubPackages = pkgGroup.packages && Object.keys(pkgGroup.packages).length > 0;
                                                        if (hasVersions) {
                                                            const count = pkgGroup.versions.length;
                                                            return `(${count} version${count !== 1 ? 's' : ''})`;
                                                        } else if (hasSubPackages) {
                                                            const count = Object.keys(pkgGroup.packages).length;
                                                            return `(${count} package${count !== 1 ? 's' : ''})`;
                                                        } else {
                                                            const count = pkgGroup.count !== undefined ? pkgGroup.count : 0;
                                                            return `(${count} version${count !== 1 ? 's' : ''})`;
                                                        }
                                                    })()"></span>
                                                </div>
                                                <i :class="expandedPackages[`${type}:${pkgGroup.fullName || `${groupPath}/${pkgName}`}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                            </button>
                                            <!-- Show versions if package has them (always show if expanded, even if empty initially) -->
                                            <div x-show="expandedPackages[`${type}:${pkgGroup.fullName || `${groupPath}/${pkgName}`}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                <!-- Package-level metadata (description, license, dependencies) -->
                                                <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                                        <div x-show="pkgGroup.description" class="text-gray-700">
                                                            <span class="font-medium text-gray-600">Description: </span>
                                                            <span x-text="pkgGroup.description"></span>
                                                        </div>
                                                        <div x-show="pkgGroup.license" class="text-gray-700">
                                                            <span class="font-medium text-gray-600">License: </span>
                                                            <span x-text="pkgGroup.license"></span>
                                                        </div>
                                                        <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                                            <span class="font-medium text-gray-600">Dependencies: </span>
                                                            <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- Package's own versions -->
                                                <div x-show="pkgGroup.versions && pkgGroup.versions.length > 0">
                                                    <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                    <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                         :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                         @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                        <div class="flex items-center justify-between">
                                                            <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                    <i class="ti ti-check icon mr-1"></i>
                                                                    <span>Cached</span>
                                                                </span>
                                                                <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                    <i class="ti ti-cloud icon mr-1"></i>
                                                                    <span>Available</span>
                                                                </span>
                                                                <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                    <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                    <span>Loading...</span>
                                                                </span>
                                                                <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                            </div>
                                                        </div>
                                                        <!-- Metadata display -->
                                                        <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                            <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                            <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                <span class="text-gray-500">Go Version: </span>
                                                                <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                            </div>
                                                            <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                <span class="text-gray-500">Published: </span>
                                                                <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                            </div>
                                                            <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                <span class="text-gray-500">Directories: </span>
                                                                <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                                </div>
                                                <!-- Show message if no versions and no sub-packages -->
                                                <div x-show="(!pkgGroup.versions || pkgGroup.versions.length === 0) && (!pkgGroup.packages || Object.keys(pkgGroup.packages).length === 0)" class="px-4 py-2 text-xs text-gray-500 italic">No versions available</div>
                                            </div>
                                            <!-- Show sub-packages if package has them (for Go packages with nested packages) -->
                                            <div x-show="expandedPackages[`${type}:${pkgGroup.fullName || `${groupPath}/${pkgName}`}`] === true && pkgGroup.packages && Object.keys(pkgGroup.packages).length > 0" x-cloak class="ml-4 mt-1 space-y-1">
                                                <template x-for="[subPkgName, subPkgGroup] in Object.entries(pkgGroup.packages || {})" :key="subPkgName">
                                                    <div x-show="packageMatchesSearch(subPkgName, '') || (subPkgGroup.versions && subPkgGroup.versions.some(p => packageMatchesSearch(subPkgName, p.version)))">
                                                        <button 
                                                            @click.prevent="togglePackage(type, `${pkgName}/${subPkgName}`)"
                                                            type="button"
                                                            class="w-full flex items-center justify-between px-4 py-2 bg-green-25 hover:bg-green-50 rounded transition-colors text-left">
                                                            <div class="flex items-center space-x-2 flex-1">
                                                                <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(subPkgName, type) || 'N/A'"></span>
                                                                <span class="text-xs text-gray-500" x-text="(() => { const count = subPkgGroup.count !== undefined ? subPkgGroup.count : (subPkgGroup.versions && subPkgGroup.versions.length ? subPkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                            </div>
                                                            <i :class="expandedPackages[`${type}:${pkgName}/${subPkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                        </button>
                                                        <div x-show="expandedPackages[`${type}:${pkgName}/${subPkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                            <template x-for="pkg in subPkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                <div x-show="packageMatchesSearch(subPkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                     :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                     @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                    <div class="flex items-center justify-between">
                                                                        <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                            <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                            <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                            <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                <i class="ti ti-check icon mr-1"></i>
                                                                                <span>Cached</span>
                                                                            </span>
                                                                            <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                <i class="ti ti-cloud icon mr-1"></i>
                                                                                <span>Available</span>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <!-- Show version-specific license/description if available (from index) -->
                                                                    <div x-show="pkg.license || pkg.description" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                        <div x-show="pkg.license" class="text-xs">
                                                                            <span class="text-gray-500">License: </span>
                                                                            <span class="text-gray-700" x-text="pkg.license"></span>
                                                                        </div>
                                                                        <div x-show="pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                    </div>
                                                                    <!-- Metadata display for sub-packages -->
                                                                    <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                        <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </div>
                                    </template>
                                </template>
                                <!-- Then, recursively render nested groups -->
                                <template x-for="[nestedGroupKey, nestedGroupData] in Object.entries(groupData.groups || {})" :key="nestedGroupKey">
                                    <div x-data="{ nestedDepth: depth + 1, getGroupColors: function(d) {
                                        const bgColors = ['bg-purple-100', 'bg-blue-200', 'bg-cyan-200', 'bg-teal-200', 'bg-green-200'];
                                        const hoverColors = ['hover:bg-purple-200', 'hover:bg-blue-300', 'hover:bg-cyan-300', 'hover:bg-teal-300', 'hover:bg-green-300'];
                                        const textColors = ['text-purple-700', 'text-indigo-700', 'text-cyan-800', 'text-teal-800', 'text-green-800'];
                                        const iconColors = ['text-purple-600', 'text-blue-700', 'text-cyan-700', 'text-teal-700', 'text-green-700'];
                                        const idx = Math.min(d, bgColors.length - 1);
                                        return {
                                            bgColor: bgColors[idx] || 'bg-gray-100',
                                            hoverColor: hoverColors[idx] || 'hover:bg-gray-200',
                                            textColor: textColors[idx] || 'text-gray-700',
                                            iconColor: iconColors[idx] || 'text-gray-600'
                                        };
                                    } }">
                                        <button 
                                            @click.prevent="toggleGroup(type, (type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}` : `${groupPath}:${nestedGroupKey}`)"
                                            type="button"
                                            :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(nestedDepth).bgColor} ${getGroupColors(nestedDepth).hoverColor} rounded transition-colors text-left mb-1`">
                                            <div class="flex items-center space-x-2">
                                                <i :class="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}` : `${groupPath}:${nestedGroupKey}`}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" :class="`icon ${getGroupColors(nestedDepth).iconColor} text-xs`"></i>
                                                <span :class="`text-xs font-medium ${getGroupColors(nestedDepth).textColor}`" x-text="type === 'go' ? formatGoPackageName(nestedGroupKey, type) : nestedGroupKey"></span>
                                                <span :class="`text-xs ${getGroupColors(nestedDepth).iconColor}`" x-text="`(${nestedGroupData.count || 0} packages)`"></span>
                                            </div>
                                        </button>
                                        <div x-show="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}` : `${groupPath}:${nestedGroupKey}`}`] === true" x-cloak class="ml-2">
                                            <!-- First, render packages if they exist (leaf nodes) -->
                                            <div x-show="nestedGroupData.packages && Object.keys(nestedGroupData.packages).length > 0 && (!nestedGroupData.groups || Object.keys(nestedGroupData.groups).length === 0)">
                                                <template x-for="[pkgName, pkgGroup] in Object.entries(nestedGroupData.packages || {})" :key="pkgName">
                                                    <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                        <button 
                                                            @click.prevent="togglePackage(type, pkgName)"
                                                            type="button"
                                                            class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                            <div class="flex items-center space-x-2 flex-1">
                                                                <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                                <span class="text-xs text-gray-500" x-text="(() => { const count = pkgGroup.count !== undefined ? pkgGroup.count : (pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                            </div>
                                                            <i :class="expandedPackages[`${type}:${pkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                        </button>
                                                        <div x-show="expandedPackages[`${type}:${pkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                            <!-- Package-level metadata (description, license, dependencies) -->
                                                            <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                                                    <div x-show="pkgGroup.description" class="text-gray-700">
                                                                        <span class="font-medium text-gray-600">Description: </span>
                                                                        <span x-text="pkgGroup.description"></span>
                                                                    </div>
                                                                    <div x-show="pkgGroup.license" class="text-gray-700">
                                                                        <span class="font-medium text-gray-600">License: </span>
                                                                        <span x-text="pkgGroup.license"></span>
                                                                    </div>
                                                                    <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                                                        <span class="font-medium text-gray-600">Dependencies: </span>
                                                                        <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                     :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                     @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                    <div class="flex items-center justify-between">
                                                                        <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                            <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                            <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                            <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                <i class="ti ti-check icon mr-1"></i>
                                                                                <span>Cached</span>
                                                                            </span>
                                                                            <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                <i class="ti ti-cloud icon mr-1"></i>
                                                                                <span>Available</span>
                                                                            </span>
                                                                            <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                            <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                            <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                <span>Loading...</span>
                                                                            </span>
                                                                            <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                        </div>
                                                                    </div>
                                                                    <!-- Show version-specific license/description if available (from index) -->
                                                                    <div x-show="pkg.license || pkg.description" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                        <div x-show="pkg.license" class="text-xs">
                                                                            <span class="text-gray-500">License: </span>
                                                                            <span class="text-gray-700" x-text="pkg.license"></span>
                                                                        </div>
                                                                        <div x-show="pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                    </div>
                                                                    <!-- Metadata display -->
                                                            <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                            <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                            <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                <span class="text-gray-500">Go Version: </span>
                                                                                <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                            </div>
                                                                            <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                <span class="text-gray-500">Published: </span>
                                                                                <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                            </div>
                                                                            <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                <span class="text-gray-500">Directories: </span>
                                                                                <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                            </div>
                                                                        </div>
                                                                    </template>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                            </template>
                                            <!-- Recursively render deeper groups or packages -->
                                            <div x-show="nestedGroupData.groups && Object.keys(nestedGroupData.groups).length > 0">
                                                <template x-for="[deeperGroupKey, deeperGroupData] in Object.entries(nestedGroupData.groups || {})" :key="deeperGroupKey">
                                                    <div x-data="{ deeperDepth: nestedDepth + 1, getGroupColors: function(d) {
                                                        const bgColors = ['bg-purple-100', 'bg-blue-200', 'bg-cyan-200', 'bg-teal-200', 'bg-green-200'];
                                                        const hoverColors = ['hover:bg-purple-200', 'hover:bg-blue-300', 'hover:bg-cyan-300', 'hover:bg-teal-300', 'hover:bg-green-300'];
                                                        const textColors = ['text-purple-700', 'text-indigo-700', 'text-cyan-800', 'text-teal-800', 'text-green-800'];
                                                        const iconColors = ['text-purple-600', 'text-blue-700', 'text-cyan-700', 'text-teal-700', 'text-green-700'];
                                                        const idx = Math.min(d, bgColors.length - 1);
                                                        return {
                                                            bgColor: bgColors[idx] || 'bg-gray-100',
                                                            hoverColor: hoverColors[idx] || 'hover:bg-gray-200',
                                                            textColor: textColors[idx] || 'text-gray-700',
                                                            iconColor: iconColors[idx] || 'text-gray-600'
                                                        };
                                                    } }">
                                                        <button 
                                                            @click.prevent="toggleGroup(type, (type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}`)"
                                                            type="button"
                                                            :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(deeperDepth).bgColor} ${getGroupColors(deeperDepth).hoverColor} rounded transition-colors text-left mb-1`">
                                                            <div class="flex items-center space-x-2">
                                                                <i :class="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}`}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" :class="`icon ${getGroupColors(deeperDepth).iconColor} text-xs`"></i>
                                                                <span :class="`text-xs font-medium ${getGroupColors(deeperDepth).textColor}`" x-text="type === 'go' ? formatGoPackageName(deeperGroupKey, type) : deeperGroupKey"></span>
                                                                <span :class="`text-xs ${getGroupColors(deeperDepth).iconColor}`" x-text="`(${deeperGroupData.count || 0} packages)`"></span>
                                                            </div>
                                                        </button>
                                                        <div x-show="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}`}`] === true" x-cloak class="ml-2">
                                                            <!-- First, render packages if they exist (leaf nodes) -->
                                                            <div x-show="deeperGroupData.packages && Object.keys(deeperGroupData.packages).length > 0 && (!deeperGroupData.groups || Object.keys(deeperGroupData.groups).length === 0)">
                                                                <template x-for="[pkgName, pkgGroup] in Object.entries(deeperGroupData.packages || {})" :key="pkgName">
                                                                <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                                    <button 
                                                                        @click.prevent="togglePackage(type, pkgName)"
                                                                        type="button"
                                                                        class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                                        <div class="flex items-center space-x-2 flex-1">
                                                                            <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                                            <span class="text-xs text-gray-500" x-text="(() => { const count = pkgGroup.count !== undefined ? pkgGroup.count : (pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                                        </div>
                                                                        <i :class="expandedPackages[`${type}:${pkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                                    </button>
                                                                    <div x-show="expandedPackages[`${type}:${pkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                                        <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                            <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                                 :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                                 @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                                <div class="flex items-center justify-between">
                                                                                    <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                        <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                        <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                        <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                            <i class="ti ti-check icon mr-1"></i>
                                                                                            <span>Cached</span>
                                                                                        </span>
                                                                                        <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                            <i class="ti ti-cloud icon mr-1"></i>
                                                                                            <span>Available</span>
                                                                                        </span>
                                                                                        <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                                        <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                                        <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                            <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                            <span>Loading...</span>
                                                                                        </span>
                                                                                        <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                                    </div>
                                                                                </div>
                                                                                <!-- Show version-specific license/description if available (from index) -->
                                                                                <div x-show="pkg.license || pkg.description" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                                    <div x-show="pkg.license" class="text-xs">
                                                                                        <span class="text-gray-500">License: </span>
                                                                                        <span class="text-gray-700" x-text="pkg.license"></span>
                                                                                    </div>
                                                                                    <div x-show="pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                                </div>
                                                                                <!-- Metadata display -->
                                                            <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                                        <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                                        <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                            <span class="text-gray-500">Go Version: </span>
                                                                                            <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                                        </div>
                                                                                        <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                            <span class="text-gray-500">Published: </span>
                                                                                            <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                                        </div>
                                                                                        <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                            <span class="text-gray-500">Directories: </span>
                                                                                            <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                                        </div>
                                                                                    </div>
                                                                                </template>
                                                                            </div>
                                                                        </template>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            </template>
                                                            <!-- Recursively render even deeper groups (depth 3+) -->
                                                            <div x-show="deeperGroupData.groups && Object.keys(deeperGroupData.groups).length > 0">
                                                                <template x-for="[evenDeeperGroupKey, evenDeeperGroupData] in Object.entries(deeperGroupData.groups || {})" :key="evenDeeperGroupKey">
                                                                    <div x-data="{ evenDeeperDepth: deeperDepth + 1, getGroupColors: function(d) {
                                                                        const bgColors = ['bg-purple-100', 'bg-blue-200', 'bg-cyan-200', 'bg-teal-200', 'bg-green-200'];
                                                                        const hoverColors = ['hover:bg-purple-200', 'hover:bg-blue-300', 'hover:bg-cyan-300', 'hover:bg-teal-300', 'hover:bg-green-300'];
                                                                        const textColors = ['text-purple-700', 'text-indigo-700', 'text-cyan-800', 'text-teal-800', 'text-green-800'];
                                                                        const iconColors = ['text-purple-600', 'text-blue-700', 'text-cyan-700', 'text-teal-700', 'text-green-700'];
                                                                        const idx = Math.min(d, bgColors.length - 1);
                                                                        return {
                                                                            bgColor: bgColors[idx] || 'bg-gray-100',
                                                                            hoverColor: hoverColors[idx] || 'hover:bg-gray-200',
                                                                            textColor: textColors[idx] || 'text-gray-700',
                                                                            iconColor: iconColors[idx] || 'text-gray-600'
                                                                        };
                                                                    } }">
                                                                        <button 
                                                                            @click.prevent="toggleGroup(type, (type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}/${evenDeeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}:${evenDeeperGroupKey}`)"
                                                                            type="button"
                                                                            :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(evenDeeperDepth).bgColor} ${getGroupColors(evenDeeperDepth).hoverColor} rounded transition-colors text-left mb-1`">
                                                                            <div class="flex items-center space-x-2">
                                                                                <i :class="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}/${evenDeeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}:${evenDeeperGroupKey}`}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" :class="`icon ${getGroupColors(evenDeeperDepth).iconColor} text-xs`"></i>
                                                                                <span :class="`text-xs font-medium ${getGroupColors(evenDeeperDepth).textColor}`" x-text="type === 'go' ? formatGoPackageName(evenDeeperGroupKey, type) : evenDeeperGroupKey"></span>
                                                                                <span :class="`text-xs ${getGroupColors(evenDeeperDepth).iconColor}`" x-text="`(${evenDeeperGroupData.count || 0} packages)`"></span>
                                                                            </div>
                                                                        </button>
                                                                        <div x-show="expandedGroups[`${type}:${(type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}/${deeperGroupKey}/${evenDeeperGroupKey}` : `${groupPath}:${nestedGroupKey}:${deeperGroupKey}:${evenDeeperGroupKey}`}`] === true" x-cloak class="ml-2">
                                                                            <!-- Render packages at this level -->
                                                                            <div x-show="evenDeeperGroupData.packages && Object.keys(evenDeeperGroupData.packages).length > 0">
                                                                                <template x-for="[pkgName, pkgGroup] in Object.entries(evenDeeperGroupData.packages || {})" :key="pkgName">
                                                                                    <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                                                        <button 
                                                                                            @click.prevent="togglePackage(type, pkgName)"
                                                                                            type="button"
                                                                                            class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                                                            <div class="flex items-center space-x-2 flex-1">
                                                                                                <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                                                                <span class="text-xs text-gray-500" x-text="(() => { const count = pkgGroup.count !== undefined ? pkgGroup.count : (pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                                                            </div>
                                                                                            <i :class="expandedPackages[`${type}:${pkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                                                        </button>
                                                                                        <div x-show="expandedPackages[`${type}:${pkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                                                            <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                                                <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                                                     :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                                                     @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                                                    <div class="flex items-center justify-between">
                                                                                                        <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                                            <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                                            <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                                            <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                                                <i class="ti ti-check icon mr-1"></i>
                                                                                                                <span>Cached</span>
                                                                                                            </span>
                                                                                                            <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                                                <i class="ti ti-cloud icon mr-1"></i>
                                                                                                                <span>Available</span>
                                                                                                            </span>
                                                                                                            <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                                                            <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                                                            <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                                                <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                                                <span>Loading...</span>
                                                                                                            </span>
                                                                                                            <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                    <!-- Metadata display -->
                                                            <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                                                            <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                                                            <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                                                <span class="text-gray-500">Go Version: </span>
                                                                                                                <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                                                            </div>
                                                                                                            <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                                                <span class="text-gray-500">Published: </span>
                                                                                                                <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                                                            </div>
                                                                                                            <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                                                <span class="text-gray-500">Directories: </span>
                                                                                                                <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </template>
                                                                                                </div>
                                                                                            </template>
                                                                                        </div>
                                                                                    </div>
                                                                                </template>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </template>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                            <!-- NOTE: Packages are already rendered above at line 212 when nestedGroupData has packages but no groups. This duplicate block has been removed. -->
                                        </div>
                                    </div>
                                </template>
                                <!-- Packages are already rendered above (line 55), no need to render again here -->
                            </div>
                        </div>
                    </div>
                
                    <!-- Then, show root-level packages (single-part names that don't have groups) -->
                    <div x-show="packageTree[type] && packageTree[type].packages && Object.keys(packageTree[type].packages).length > 0">
                        <template x-for="[pkgName, pkgGroup] in Object.entries(packageTree[type].packages || {})" :key="`root-${pkgName}`">
                        <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                            <!-- Package Name Header (Collapsible) -->
                            <button 
                                @click.prevent="togglePackage(type, pkgGroup.fullName || pkgName)"
                                type="button"
                                class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left mb-1">
                                <div class="flex items-center space-x-2 flex-1">
                                    <span class="text-sm font-medium text-gray-700" x-text="pkgName"></span>
                                    <span class="text-xs text-gray-500" x-text="`(${pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0} version${(pkgGroup.versions && pkgGroup.versions.length !== 1) ? 's' : ''})`"></span>
                                </div>
                                <i :class="expandedPackages[`${type}:${pkgGroup.fullName || pkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                            </button>
                            <!-- Versions (Nested) - reuse the same version display logic from groups -->
                            <div x-show="expandedPackages[`${type}:${pkgGroup.fullName || pkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                <!-- Package-level metadata (description, license, dependencies) -->
                                <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                        <div x-show="pkgGroup.description" class="text-gray-700">
                                            <span class="font-medium text-gray-600">Description: </span>
                                            <span x-text="pkgGroup.description"></span>
                                        </div>
                                        <div x-show="pkgGroup.license" class="text-gray-700">
                                            <span class="font-medium text-gray-600">License: </span>
                                            <span x-text="pkgGroup.license"></span>
                                        </div>
                                        <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                            <span class="font-medium text-gray-600">Dependencies: </span>
                                            <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                        </div>
                                    </div>
                                </template>
                                <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                    <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                         :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                         @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    <i class="ti ti-check icon mr-1"></i>
                                                    <span>Cached</span>
                                                </span>
                                                <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                    <i class="ti ti-cloud icon mr-1"></i>
                                                    <span>Available</span>
                                                </span>
                                            </div>
                                        </div>
                                        <!-- Show version-specific license if available (from index) -->
                                        <!-- For APT: show license per version, but not description (description is package-level only) -->
                                        <div x-show="pkg.license || (type !== 'apt' && pkg.description)" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                            <div x-show="pkg.license" class="text-xs">
                                                <span class="text-gray-500">License: </span>
                                                <span class="text-gray-700" x-text="pkg.license"></span>
                                            </div>
                                            <!-- Only show description for non-APT packages (APT description is package-level only) -->
                                            <div x-show="type !== 'apt' && pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                        </div>
                                        <div x-show="pkg.architecture" class="mt-1">
                                            <span class="text-xs text-gray-500">Architecture: </span>
                                            <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                
                <!-- Other types: Render flat groups -->
                <!-- Also render "default" group for APT/Go if it exists (when hierarchical grouping failed) -->
                <!-- Exclude hierarchical groups (those with ":") for APT and Go -->
                <!-- For Go, also exclude hostnames that are in the hierarchy (they're rendered in hierarchical section) -->
                    <template x-for="[groupName, groupData] in getFlatGroups(type)" :key="`${type}-${groupName}`">
                    <!-- Show "default" group for all types, or flat groups (without "/" or ":") for types that use flat grouping -->
                    <!-- Exclude hierarchical groups (with "/" or ":") which are rendered in the hierarchical section above -->
                    <!-- Also exclude NPM scoped groups (starting with "@") which are rendered in the hierarchical section -->
                    <!-- Go packages are ALWAYS in hierarchical section, never in flat section -->
                    <div x-show="expandedTypes[type] === true && type !== 'go' && (groupName === 'default' || (!groupName.includes('/') && !groupName.includes(':') && !(type === 'npm' && groupName.startsWith('@'))))" x-cloak class="mb-2">
                        <!-- Group Header (Collapsible) -->
                        <!-- Show toggle button for all groups (including non-APT default) -->
                        <button 
                            @click.prevent="toggleGroup(type, groupName)"
                            type="button"
                            class="w-full flex items-center justify-between px-3 py-2 bg-blue-50 hover:bg-blue-100 rounded transition-colors text-left mb-1">
                            <div class="flex items-center space-x-2">
                                <i :class="expandedGroups[`${type}:${groupName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-blue-600 text-xs"></i>
                                <span class="text-xs font-medium text-blue-700" x-text="groupName"></span>
                                <span class="text-xs text-blue-600" x-text="`(${groupData.count} packages)`"></span>
                            </div>
                        </button>
                        <!-- Packages within Group -->
                        <!-- Show packages when group is expanded -->
                        <div x-show="expandedGroups[`${type}:${groupName}`] === true" x-cloak class="ml-2">
                            <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                    <!-- Package Name Header (Collapsible) -->
                                    <button 
                                        @click.prevent="togglePackage(type, pkgName)"
                                        type="button"
                                        class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                        <div class="flex items-center space-x-2 flex-1">
                                            <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                            <span class="text-xs text-gray-500" x-text="`(${pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0} version${(pkgGroup.versions && pkgGroup.versions.length !== 1) ? 's' : ''})`"></span>
                                            <!-- Show first version ID if package name is N/A -->
                                            <span x-show="(pkgName === 'N/A' || !pkgName) && pkgGroup.versions && pkgGroup.versions.length > 0 && pkgGroup.versions[0] && pkgGroup.versions[0].id" class="text-xs text-gray-400 font-mono ml-2" x-text="pkgGroup.versions && pkgGroup.versions[0] ? `ID: ${pkgGroup.versions[0].id || 'N/A'}` : 'ID: N/A'"></span>
                                        </div>
                                        <i :class="expandedPackages[`${type}:${pkgName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                    </button>
                                    
                                    <!-- Versions (Nested) -->
                                    <div x-show="expandedPackages[`${type}:${pkgName}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                        <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                            <div x-show="packageMatchesSearch(pkgName, pkg.version)" class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                 :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                 @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                <div class="flex items-center justify-between">
                                                    <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                        <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                        <span x-show="pkg.version === 'N/A'" class="text-xs text-gray-400 italic" x-text="`ID: ${pkg.id ? (pkg.id.split('/').pop() || pkg.id) : (pkg.version || 'N/A')}`"></span>
                                                        <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                        <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                            <i class="ti ti-check icon mr-1"></i>
                                                            <span>Cached</span>
                                                        </span>
                                                        <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                            <i class="ti ti-cloud icon mr-1"></i>
                                                            <span>Available</span>
                                                        </span>
                                                        <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                        <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                        <!-- Loading indicator for NPM/PyPI/Go/APK metadata -->
                                                        <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                            <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                            <span>Loading...</span>
                                                        </span>
                                                        <!-- Click hint for NPM/PyPI/Go/APK packages -->
                                                        <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                    </div>
                                                </div>
                                                <!-- Show architecture if available (for APK, may show multiple architectures) -->
                                                <div x-show="pkg.architecture" class="mt-1">
                                                    <span class="text-xs text-gray-500">Architecture<span x-show="type === 'apk' && pkg.architecture.includes(',')">s</span>: </span>
                                                    <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                                </div>
                                                <!-- Show license if available (version-specific from index, or from metadata, or package-level) -->
                                                <!-- For APT: always show license per version if available -->
                                                <div x-show="pkg.license || (pkg.metadata && pkg.metadata.license) || (type === 'apt' ? false : pkgGroup.license)" class="mt-1">
                                                    <span class="text-xs text-gray-500">License: </span>
                                                    <span class="text-xs text-gray-700" x-text="pkg.license || (pkg.metadata && pkg.metadata.license ? (typeof pkg.metadata.license === 'string' ? pkg.metadata.license : (pkg.metadata.license && pkg.metadata.license.type ? pkg.metadata.license.type : '')) : '') || (type === 'apt' ? '' : (pkgGroup.license || ''))"></span>
                                                </div>
                                                <!-- Show description if available (from metadata or index) -->
                                                <!-- For APT: don't show description per version (it's package-level only) -->
                                                <div x-show="type !== 'apt' && (pkg.description || (pkg.metadata && pkg.metadata.description))" class="mt-1">
                                                    <span class="text-xs text-gray-600" x-text="pkg.description || (pkg.metadata && pkg.metadata.description) || ''"></span>
                                                </div>
                                                <!-- Show dependencies if available (from metadata or index) -->
                                                <div x-show="(pkg.dependencies && Array.isArray(pkg.dependencies) && pkg.dependencies.length > 0) || (pkg.metadata && pkg.metadata.dependencies && ((Array.isArray(pkg.metadata.dependencies) && pkg.metadata.dependencies.length > 0) || (typeof pkg.metadata.dependencies === 'object' && !Array.isArray(pkg.metadata.dependencies) && Object.keys(pkg.metadata.dependencies).length > 0)))" class="mt-1">
                                                    <span class="text-xs text-gray-500">Depends: </span>
                                                    <span class="text-xs text-gray-600" x-text="(pkg.dependencies && Array.isArray(pkg.dependencies)) ? pkg.dependencies.join(', ') : (pkg.metadata && pkg.metadata.dependencies ? (Array.isArray(pkg.metadata.dependencies) ? pkg.metadata.dependencies.join(', ') : (typeof pkg.metadata.dependencies === 'object' && !Array.isArray(pkg.metadata.dependencies) ? Object.keys(pkg.metadata.dependencies).join(', ') : '')) : '')"></span>
                                                </div>
                                                <!-- Show additional metadata from package.json for NPM/PyPI/Go/APK -->
                                                <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                        <!-- NPM/PyPI specific fields -->
                                                        <div x-show="(type === 'npm' || type === 'pypi') && pkg.metadata && pkg.metadata.author" class="text-xs">
                                                            <span class="text-gray-500">Author: </span>
                                                            <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.author) ? (typeof pkg.metadata.author === 'string' ? pkg.metadata.author : (pkg.metadata.author && pkg.metadata.author.name ? pkg.metadata.author.name : '')) : ''"></span>
                                                        </div>
                                                        <!-- License: prefer version-specific from index, then metadata, then package-level -->
                                                        <div x-show="pkg.license || (pkg.metadata && pkg.metadata.license) || pkgGroup.license" class="text-xs">
                                                            <span class="text-gray-500">License: </span>
                                                            <span class="text-gray-700" x-text="pkg.license || (pkg.metadata && pkg.metadata.license ? (typeof pkg.metadata.license === 'string' ? pkg.metadata.license : (pkg.metadata.license && pkg.metadata.license.type ? pkg.metadata.license.type : '')) : '') || pkgGroup.license || ''"></span>
                                                        </div>
                                                        <div x-show="pkg.metadata.homepage" class="text-xs">
                                                            <span class="text-gray-500">Homepage: </span>
                                                            <a :href="pkg.metadata.homepage" target="_blank" class="text-blue-600 hover:underline" x-text="pkg.metadata.homepage"></a>
                                                        </div>
                                                        <div x-show="(type === 'npm' || type === 'pypi') && pkg.metadata.repository" class="text-xs">
                                                            <span class="text-gray-500">Repository: </span>
                                                            <a :href="typeof pkg.metadata.repository === 'string' ? pkg.metadata.repository : (pkg.metadata.repository && pkg.metadata.repository.url ? pkg.metadata.repository.url : '')" target="_blank" class="text-blue-600 hover:underline" x-text="typeof pkg.metadata.repository === 'string' ? pkg.metadata.repository : (pkg.metadata.repository && pkg.metadata.repository.url ? pkg.metadata.repository.url : '')"></a>
                                                        </div>
                                                        <div x-show="(type === 'npm' || type === 'pypi') && pkg.metadata.keywords && Array.isArray(pkg.metadata.keywords) && pkg.metadata.keywords.length > 0" class="text-xs">
                                                            <span class="text-gray-500">Keywords: </span>
                                                            <span class="text-gray-700" x-text="(pkg.metadata.keywords && Array.isArray(pkg.metadata.keywords)) ? pkg.metadata.keywords.join(', ') : ''"></span>
                                                        </div>
                                                        <!-- Go specific fields -->
                                                        <div x-show="type === 'go' && pkg.metadata.description" class="text-xs mt-1">
                                                            <span class="text-gray-600" x-text="pkg.metadata.description"></span>
                                                        </div>
                                                        <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                            <span class="text-gray-500">Go Version: </span>
                                                            <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                        </div>
                                                        <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                            <span class="text-gray-500">Published: </span>
                                                            <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                        </div>
                                                        <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                            <span class="text-gray-500">Directories: </span>
                                                            <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                        </div>
                                                        <!-- APK specific fields -->
                                                        <div x-show="type === 'apk' && pkg.metadata.description" class="text-xs mt-1">
                                                            <span class="text-gray-600" x-text="pkg.metadata.description"></span>
                                                        </div>
                                                        <div x-show="type === 'apk' && pkg.metadata.architecture" class="text-xs">
                                                            <span class="text-gray-500">Architecture: </span>
                                                            <span class="text-gray-700 font-mono" x-text="pkg.metadata.architecture"></span>
                                                        </div>
                                                        <div x-show="type === 'apk' && pkg.metadata.size" class="text-xs">
                                                            <span class="text-gray-500">Size: </span>
                                                            <span class="text-gray-700" x-text="pkg.metadata.size"></span>
                                                        </div>
                                                        <!-- License: prefer version-specific from index, then metadata, then package-level -->
                                                        <div x-show="pkg.license || (type === 'apk' && pkg.metadata && pkg.metadata.license) || pkgGroup.license" class="text-xs">
                                                            <span class="text-gray-500">License: </span>
                                                            <span class="text-gray-700" x-text="pkg.license || (type === 'apk' && pkg.metadata && pkg.metadata.license ? pkg.metadata.license : '') || pkgGroup.license || ''"></span>
                                                        </div>
                                                        <div x-show="type === 'apk' && pkg.metadata.homepage" class="text-xs">
                                                            <span class="text-gray-500">Homepage: </span>
                                                            <a :href="pkg.metadata.homepage" target="_blank" class="text-blue-600 hover:underline" x-text="pkg.metadata.homepage"></a>
                                                        </div>
                                                    </div>
                                                </template>
                                                <!-- Show ID for N/A entries to help debug -->
                                                <div x-show="!pkg.name || !pkg.version || pkg.name === 'N/A' || pkg.version === 'N/A'" class="mt-1">
                                                    <span class="text-xs text-gray-400 italic" x-text="`ID: ${pkg.id ? (pkg.id.split('/').pop() || pkg.id) : (pkg.version || 'N/A')}`"></span>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
    </template>
</template>
