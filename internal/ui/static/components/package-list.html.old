<!-- Package List Component - Truly Recursive -->
<template id="package-list-component">
    <template x-for="type in ['apk', 'apt', 'npm', 'pypi', 'go']" :key="type">
        <div x-show="packageTree && packageTree[type] !== undefined" class="mb-2" :data-type="type">
            <!-- Type Header -->
            <button 
                @click.prevent="toggleType(type)"
                type="button"
                class="w-full flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-gray-100 rounded-lg transition-colors text-left">
                <div class="flex items-center space-x-3">
                    <i :class="getTypeIcon(type)" class="icon text-gray-600"></i>
                    <span class="font-semibold text-gray-900 capitalize" x-text="type"></span>
                    <span class="text-sm text-gray-500" x-text="`(${(packageTree[type] && packageTree[type].count) || 0} packages)`"></span>
                </div>
                <i :class="expandedTypes[type] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400"></i>
            </button>
            
            <div x-show="expandedTypes && expandedTypes[type] === true" x-cloak class="ml-4 mt-2 space-y-1">
                <!-- Hierarchical Groups - RECURSIVE -->
                <template x-for="groupKey in Object.keys((packageTree[type] && packageTree[type].groups) || {}).sort((a, b) => a.localeCompare(b))" :key="groupKey">
                    <div x-show="groupKey !== 'default' && packageTree[type] && packageTree[type].groups && packageTree[type].groups[groupKey] && ((packageTree[type].groups[groupKey].groups && Object.keys(packageTree[type].groups[groupKey].groups).length > 0) || (packageTree[type].groups[groupKey].packages && Object.keys(packageTree[type].groups[groupKey].packages).length > 0))" 
                         x-cloak>
                        <!-- RECURSIVE GROUP COMPONENT - This structure repeats itself -->
                        <div x-data="{ 
                            groupData: packageTree[type] && packageTree[type].groups ? packageTree[type].groups[groupKey] : {}, 
                            groupPath: groupKey, 
                            groupKey: groupKey, 
                            depth: 0
                        }">
                            <!-- Group Button -->
                            <button 
                                @click.prevent="toggleGroup(type, groupPath)"
                                type="button"
                                :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(depth).bgColor} ${getGroupColors(depth).hoverColor} rounded transition-colors text-left mb-1`">
                                <div class="flex items-center space-x-2">
                                    <i :class="expandedGroups[`${type}:${groupPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" 
                                       :class="`icon ${getGroupColors(depth).iconColor} text-xs`"></i>
                                    <span :class="`text-xs font-medium ${getGroupColors(depth).textColor}`" 
                                          x-text="type === 'go' ? formatGoPackageName(groupKey, type) : groupKey"></span>
                                    <span :class="`text-xs ${getGroupColors(depth).iconColor}`" 
                                          x-text="`(${groupData.count || 0} packages)`"></span>
                                </div>
                            </button>
                            
                            <!-- Group Content -->
                            <div x-show="expandedGroups[`${type}:${groupPath}`] === true" x-cloak class="ml-2">
                                <!-- Packages in this group -->
                                <template x-if="groupData.packages && Object.keys(groupData.packages).length > 0">
                                    <div>
                                        <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                            <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                <!-- Include package renderer component -->
                                                <div x-data="{ pkgName: pkgName, pkgGroup: pkgGroup, pkgPath: pkgGroup.fullName || `${groupPath}/${pkgName}` }">
                                                    <!-- Package Button -->
                                                    <button 
                                                        @click.prevent="togglePackage(type, pkgPath)"
                                                        type="button"
                                                        class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                        <div class="flex items-center space-x-2 flex-1">
                                                            <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                            <span class="text-xs text-gray-500" x-text="(() => { 
                                                                const hasVersions = pkgGroup.versions && pkgGroup.versions.length > 0;
                                                                const hasSubPackages = pkgGroup.packages && Object.keys(pkgGroup.packages).length > 0;
                                                                if (hasVersions) {
                                                                    const count = pkgGroup.versions.length;
                                                                    return `(${count} version${count !== 1 ? 's' : ''})`;
                                                                } else if (hasSubPackages) {
                                                                    const count = Object.keys(pkgGroup.packages).length;
                                                                    return `(${count} package${count !== 1 ? 's' : ''})`;
                                                                } else {
                                                                    const count = pkgGroup.count !== undefined ? pkgGroup.count : 0;
                                                                    return `(${count} version${count !== 1 ? 's' : ''})`;
                                                                }
                                                            })()"></span>
                                                        </div>
                                                        <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                    </button>
                                                    
                                                    <!-- Package Content -->
                                                    <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                        <!-- Package Metadata -->
                                                        <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" 
                                                             class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                                            <div x-show="pkgGroup.description" class="text-gray-700">
                                                                <span class="font-medium text-gray-600">Description: </span>
                                                                <span x-text="pkgGroup.description"></span>
                                                            </div>
                                                            <div x-show="pkgGroup.license" class="text-gray-700">
                                                                <span class="font-medium text-gray-600">License: </span>
                                                                <span x-text="pkgGroup.license"></span>
                                                            </div>
                                                            <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                                                <span class="font-medium text-gray-600">Dependencies: </span>
                                                                <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- Versions -->
                                                        <template x-if="pkgGroup.versions && pkgGroup.versions.length > 0">
                                                            <div>
                                                                <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                    <div x-show="packageMatchesSearch(pkgName, pkg.version)" 
                                                                         class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                         :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                         @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                        <div class="flex items-center justify-between">
                                                                            <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                    <i class="ti ti-check icon mr-1"></i>
                                                                                    <span>Cached</span>
                                                                                </span>
                                                                                <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                    <i class="ti ti-cloud icon mr-1"></i>
                                                                                    <span>Available</span>
                                                                                </span>
                                                                                <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                                <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                                <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                    <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                    <span>Loading...</span>
                                                                                </span>
                                                                                <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                            </div>
                                                                        </div>
                                                                        <!-- Version Metadata -->
                                                                        <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                            <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                            <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                <span class="text-gray-500">Go Version: </span>
                                                                                <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                            </div>
                                                                            <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                <span class="text-gray-500">Published: </span>
                                                                                <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                            </div>
                                                                            <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                <span class="text-gray-500">Directories: </span>
                                                                                <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </template>
                                                            </div>
                                                        </template>
                                                        
                                                        <!-- Sub-packages (for Go) -->
                                                        <template x-if="pkgGroup.packages && Object.keys(pkgGroup.packages).length > 0">
                                                            <div class="ml-4 mt-1 space-y-1">
                                                                <template x-for="[subPkgName, subPkgGroup] in Object.entries(pkgGroup.packages || {})" :key="subPkgName">
                                                                    <div x-show="packageMatchesSearch(subPkgName, '') || (subPkgGroup.versions && subPkgGroup.versions.some(p => packageMatchesSearch(subPkgName, p.version)))">
                                                                        <!-- RECURSIVE: Use same package structure -->
                                                                        <div x-data="{ pkgName: subPkgName, pkgGroup: subPkgGroup, pkgPath: `${pkgName}/${subPkgName}` }">
                                                                            <button 
                                                                                @click.prevent="togglePackage(type, pkgPath)"
                                                                                type="button"
                                                                                class="w-full flex items-center justify-between px-4 py-2 bg-green-25 hover:bg-green-50 rounded transition-colors text-left">
                                                                                <div class="flex items-center space-x-2 flex-1">
                                                                                    <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(subPkgName, type) || 'N/A'"></span>
                                                                                    <span class="text-xs text-gray-500" x-text="(() => { const count = subPkgGroup.count !== undefined ? subPkgGroup.count : (subPkgGroup.versions && subPkgGroup.versions.length ? subPkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                                                </div>
                                                                                <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                                            </button>
                                                                            <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                                                <template x-for="pkg in subPkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                                    <div x-show="packageMatchesSearch(subPkgName, pkg.version)" 
                                                                                         class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                                         :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                                         @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                                        <div class="flex items-center justify-between">
                                                                                            <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                                <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                                <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                                <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                                    <i class="ti ti-check icon mr-1"></i>
                                                                                                    <span>Cached</span>
                                                                                                </span>
                                                                                                <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                                    <i class="ti ti-cloud icon mr-1"></i>
                                                                                                    <span>Available</span>
                                                                                                </span>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div x-show="pkg.license || pkg.description" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                                            <div x-show="pkg.license" class="text-xs">
                                                                                                <span class="text-gray-500">License: </span>
                                                                                                <span class="text-gray-700" x-text="pkg.license"></span>
                                                                                            </div>
                                                                                            <div x-show="pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                                        </div>
                                                                                        <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                                            <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                                        </div>
                                                                                    </div>
                                                                                </template>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </template>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                
                                <!-- RECURSIVE: Nested groups use the EXACT SAME structure -->
                                <template x-if="groupData.groups && Object.keys(groupData.groups).length > 0">
                                    <div>
                                        <template x-for="[nestedGroupKey, nestedGroupData] in Object.entries(groupData.groups || {})" :key="nestedGroupKey">
                                            <!-- RECURSION: New x-data scope with incremented depth, same structure -->
                                            <div x-data="{ 
                                                groupData: nestedGroupData, 
                                                groupPath: (type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${nestedGroupKey}` : `${groupPath}:${nestedGroupKey}`, 
                                                groupKey: nestedGroupKey, 
                                                depth: depth + 1
                                            }">
                                                <!-- SAME GROUP BUTTON STRUCTURE -->
                                                <button 
                                                    @click.prevent="toggleGroup(type, groupPath)"
                                                    type="button"
                                                    :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(depth).bgColor} ${getGroupColors(depth).hoverColor} rounded transition-colors text-left mb-1`">
                                                    <div class="flex items-center space-x-2">
                                                        <i :class="expandedGroups[`${type}:${groupPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" 
                                                           :class="`icon ${getGroupColors(depth).iconColor} text-xs`"></i>
                                                        <span :class="`text-xs font-medium ${getGroupColors(depth).textColor}`" 
                                                              x-text="type === 'go' ? formatGoPackageName(groupKey, type) : groupKey"></span>
                                                        <span :class="`text-xs ${getGroupColors(depth).iconColor}`" 
                                                              x-text="`(${groupData.count || 0} packages)`"></span>
                                                    </div>
                                                </button>
                                                
                                                <!-- SAME GROUP CONTENT STRUCTURE - This is the recursion! -->
                                                <div x-show="expandedGroups[`${type}:${groupPath}`] === true" x-cloak class="ml-2">
                                                    <!-- Packages -->
                                                    <template x-if="groupData.packages && Object.keys(groupData.packages).length > 0">
                                                        <div>
                                                            <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                                                <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                                    <div x-data="{ pkgName: pkgName, pkgGroup: pkgGroup, pkgPath: pkgGroup.fullName || pkgName }">
                                                                        <button 
                                                                            @click.prevent="togglePackage(type, pkgPath)"
                                                                            type="button"
                                                                            class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                                            <div class="flex items-center space-x-2 flex-1">
                                                                                <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                                                <span class="text-xs text-gray-500" x-text="(() => { 
                                                                                    const hasVersions = pkgGroup.versions && pkgGroup.versions.length > 0;
                                                                                    const hasSubPackages = pkgGroup.packages && Object.keys(pkgGroup.packages).length > 0;
                                                                                    if (hasVersions) {
                                                                                        const count = pkgGroup.versions.length;
                                                                                        return `(${count} version${count !== 1 ? 's' : ''})`;
                                                                                    } else if (hasSubPackages) {
                                                                                        const count = Object.keys(pkgGroup.packages).length;
                                                                                        return `(${count} package${count !== 1 ? 's' : ''})`;
                                                                                    } else {
                                                                                        const count = pkgGroup.count !== undefined ? pkgGroup.count : 0;
                                                                                        return `(${count} version${count !== 1 ? 's' : ''})`;
                                                                                    }
                                                                                })()"></span>
                                                                            </div>
                                                                            <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                                        </button>
                                                                        <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                                            <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" 
                                                                                 class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                                                                <div x-show="pkgGroup.description" class="text-gray-700">
                                                                                    <span class="font-medium text-gray-600">Description: </span>
                                                                                    <span x-text="pkgGroup.description"></span>
                                                                                </div>
                                                                                <div x-show="pkgGroup.license" class="text-gray-700">
                                                                                    <span class="font-medium text-gray-600">License: </span>
                                                                                    <span x-text="pkgGroup.license"></span>
                                                                                </div>
                                                                                <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                                                                    <span class="font-medium text-gray-600">Dependencies: </span>
                                                                                    <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                                                                </div>
                                                                            </div>
                                                                            <template x-if="pkgGroup.versions && pkgGroup.versions.length > 0">
                                                                                <div>
                                                                                    <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                                        <div x-show="packageMatchesSearch(pkgName, pkg.version)" 
                                                                                             class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                                             :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                                             @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                                            <div class="flex items-center justify-between">
                                                                                                <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                                    <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                                    <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                                    <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                                        <i class="ti ti-check icon mr-1"></i>
                                                                                                        <span>Cached</span>
                                                                                                    </span>
                                                                                                    <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                                        <i class="ti ti-cloud icon mr-1"></i>
                                                                                                        <span>Available</span>
                                                                                                    </span>
                                                                                                    <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                                                    <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                                                    <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                                        <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                                        <span>Loading...</span>
                                                                                                    </span>
                                                                                                    <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div x-show="pkg.license || (type !== 'apt' && pkg.description)" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                                                <div x-show="pkg.license" class="text-xs">
                                                                                                    <span class="text-gray-500">License: </span>
                                                                                                    <span class="text-gray-700" x-text="pkg.license"></span>
                                                                                                </div>
                                                                                                <div x-show="type !== 'apt' && pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                                            </div>
                                                                                            <div x-show="pkg.architecture" class="mt-1">
                                                                                                <span class="text-xs text-gray-500">Architecture: </span>
                                                                                                <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                                                                            </div>
                                                                                            <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                                                <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                                                <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                                    <span class="text-gray-500">Go Version: </span>
                                                                                                    <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                                                </div>
                                                                                                <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                                    <span class="text-gray-500">Published: </span>
                                                                                                    <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                                                </div>
                                                                                                <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                                    <span class="text-gray-500">Directories: </span>
                                                                                                    <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </template>
                                                                                </div>
                                                                            </template>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </template>
                                                        </div>
                                                    </template>
                                                    
                                                    <!-- RECURSION: Deeper nested groups - same structure repeats again -->
                                                    <template x-if="groupData.groups && Object.keys(groupData.groups).length > 0">
                                                        <div>
                                                            <template x-for="[deeperGroupKey, deeperGroupData] in Object.entries(groupData.groups || {})" :key="deeperGroupKey">
                                                                <!-- RECURSION: Same structure, depth + 1 -->
                                                                <div x-data="{ 
                                                                    groupData: deeperGroupData, 
                                                                    groupPath: (type === 'go' || type === 'apt' || type === 'apk') ? `${groupPath}/${deeperGroupKey}` : `${groupPath}:${deeperGroupKey}`, 
                                                                    groupKey: deeperGroupKey, 
                                                                    depth: depth + 1
                                                                }">
                                                                    <!-- Same button structure -->
                                                                    <button 
                                                                        @click.prevent="toggleGroup(type, groupPath)"
                                                                        type="button"
                                                                        :class="`w-full flex items-center justify-between px-3 py-2 ${getGroupColors(depth).bgColor} ${getGroupColors(depth).hoverColor} rounded transition-colors text-left mb-1`">
                                                                        <div class="flex items-center space-x-2">
                                                                            <i :class="expandedGroups[`${type}:${groupPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" 
                                                                               :class="`icon ${getGroupColors(depth).iconColor} text-xs`"></i>
                                                                            <span :class="`text-xs font-medium ${getGroupColors(depth).textColor}`" 
                                                                                  x-text="type === 'go' ? formatGoPackageName(groupKey, type) : groupKey"></span>
                                                                            <span :class="`text-xs ${getGroupColors(depth).iconColor}`" 
                                                                                  x-text="`(${groupData.count || 0} packages)`"></span>
                                                                        </div>
                                                                    </button>
                                                                    <div x-show="expandedGroups[`${type}:${groupPath}`] === true" x-cloak class="ml-2">
                                                                        <!-- Packages at this level -->
                                                                        <template x-if="groupData.packages && Object.keys(groupData.packages).length > 0">
                                                                            <div>
                                                                                <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                                                                    <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                                                                        <div x-data="{ pkgName: pkgName, pkgGroup: pkgGroup, pkgPath: pkgGroup.fullName || pkgName }">
                                                                                            <button 
                                                                                                @click.prevent="togglePackage(type, pkgPath)"
                                                                                                type="button"
                                                                                                class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                                                                                <div class="flex items-center space-x-2 flex-1">
                                                                                                    <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                                                                    <span class="text-xs text-gray-500" x-text="(() => { const count = pkgGroup.count !== undefined ? pkgGroup.count : (pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0); return `(${count} version${count !== 1 ? 's' : ''})`; })()"></span>
                                                                                                </div>
                                                                                                <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                                                                            </button>
                                                                                            <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                                                                                <template x-if="pkgGroup.versions && pkgGroup.versions.length > 0">
                                                                                                    <div>
                                                                                                        <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                                                                            <div x-show="packageMatchesSearch(pkgName, pkg.version)" 
                                                                                                                 class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                                                                                 :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                                                                                 @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                                                                                <div class="flex items-center justify-between">
                                                                                                                    <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                                                                                        <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                                                                                        <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                                                                                        <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                                                                            <i class="ti ti-check icon mr-1"></i>
                                                                                                                            <span>Cached</span>
                                                                                                                        </span>
                                                                                                                        <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                                                                            <i class="ti ti-cloud icon mr-1"></i>
                                                                                                                            <span>Available</span>
                                                                                                                        </span>
                                                                                                                        <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                                                                                        <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                                                                                        <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                                                                            <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                                                                            <span>Loading...</span>
                                                                                                                        </span>
                                                                                                                        <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                                                                                    </div>
                                                                                                                </div>
                                                                                                                <div x-show="pkg.license || (type !== 'apt' && pkg.description)" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                                                                                    <div x-show="pkg.license" class="text-xs">
                                                                                                                        <span class="text-gray-500">License: </span>
                                                                                                                        <span class="text-gray-700" x-text="pkg.license"></span>
                                                                                                                    </div>
                                                                                                                    <div x-show="type !== 'apt' && pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                                                                                                </div>
                                                                                                                <div x-show="pkg.architecture" class="mt-1">
                                                                                                                    <span class="text-xs text-gray-500">Architecture: </span>
                                                                                                                    <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                                                                                                </div>
                                                                                                                <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                                                                                    <div x-show="pkg.metadata.description" class="text-xs text-gray-600" x-text="pkg.metadata.description"></div>
                                                                                                                    <div x-show="type === 'go' && pkg.metadata.goVersion" class="text-xs">
                                                                                                                        <span class="text-gray-500">Go Version: </span>
                                                                                                                        <span class="text-gray-700" x-text="pkg.metadata.goVersion"></span>
                                                                                                                    </div>
                                                                                                                    <div x-show="type === 'go' && pkg.metadata.published" class="text-xs">
                                                                                                                        <span class="text-gray-500">Published: </span>
                                                                                                                        <span class="text-gray-700" x-text="pkg.metadata.published"></span>
                                                                                                                    </div>
                                                                                                                    <div x-show="type === 'go' && pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories) && pkg.metadata.directories.length > 0" class="text-xs">
                                                                                                                        <span class="text-gray-500">Directories: </span>
                                                                                                                        <span class="text-gray-700" x-text="(pkg.metadata && pkg.metadata.directories && Array.isArray(pkg.metadata.directories)) ? pkg.metadata.directories.join(', ') : ''"></span>
                                                                                                                    </div>
                                                                                                                </div>
                                                                                                            </div>
                                                                                                        </template>
                                                                                                    </div>
                                                                                                </template>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </template>
                                                                            </div>
                                                                        </template>
                                                                        <!-- Could recurse deeper, but 3 levels is usually enough -->
                                                                    </div>
                                                                </div>
                                                            </template>
                                                        </div>
                                                    </template>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>
                </template>
                
                <!-- Root-level packages -->
                <div x-show="packageTree[type] && packageTree[type].packages && Object.keys(packageTree[type].packages).length > 0">
                    <template x-for="[pkgName, pkgGroup] in Object.entries(packageTree[type].packages || {})" :key="`root-${pkgName}`">
                        <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                            <div x-data="{ pkgName: pkgName, pkgGroup: pkgGroup, pkgPath: pkgGroup.fullName || pkgName }">
                                <button 
                                    @click.prevent="togglePackage(type, pkgPath)"
                                    type="button"
                                    class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left mb-1">
                                    <div class="flex items-center space-x-2 flex-1">
                                        <span class="text-sm font-medium text-gray-700" x-text="pkgName"></span>
                                        <span class="text-xs text-gray-500" x-text="`(${pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0} version${(pkgGroup.versions && pkgGroup.versions.length !== 1) ? 's' : ''})`"></span>
                                    </div>
                                    <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                </button>
                                <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                    <div x-show="pkgGroup.description || pkgGroup.license || (pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0)" 
                                         class="px-4 py-2 mb-2 bg-blue-50 border border-blue-200 rounded text-xs space-y-1">
                                        <div x-show="pkgGroup.description" class="text-gray-700">
                                            <span class="font-medium text-gray-600">Description: </span>
                                            <span x-text="pkgGroup.description"></span>
                                        </div>
                                        <div x-show="pkgGroup.license" class="text-gray-700">
                                            <span class="font-medium text-gray-600">License: </span>
                                            <span x-text="pkgGroup.license"></span>
                                        </div>
                                        <div x-show="pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies) && pkgGroup.dependencies.length > 0" class="text-gray-700">
                                            <span class="font-medium text-gray-600">Dependencies: </span>
                                            <span x-text="(pkgGroup.dependencies && Array.isArray(pkgGroup.dependencies)) ? pkgGroup.dependencies.join(', ') : ''"></span>
                                        </div>
                                    </div>
                                    <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                        <div x-show="packageMatchesSearch(pkgName, pkg.version)" 
                                             class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                             :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                             @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                    <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                    <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                    <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                        <i class="ti ti-check icon mr-1"></i>
                                                        <span>Cached</span>
                                                    </span>
                                                    <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                        <i class="ti ti-cloud icon mr-1"></i>
                                                        <span>Available</span>
                                                    </span>
                                                </div>
                                            </div>
                                            <div x-show="pkg.license || (type !== 'apt' && pkg.description)" class="mt-1 pt-1 border-t border-gray-100 space-y-1">
                                                <div x-show="pkg.license" class="text-xs">
                                                    <span class="text-gray-500">License: </span>
                                                    <span class="text-gray-700" x-text="pkg.license"></span>
                                                </div>
                                                <div x-show="type !== 'apt' && pkg.description" class="text-xs text-gray-600" x-text="pkg.description"></div>
                                            </div>
                                            <div x-show="pkg.architecture" class="mt-1">
                                                <span class="text-xs text-gray-500">Architecture: </span>
                                                <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
                
                <!-- Flat groups (default) - simplified version -->
                <template x-for="[groupName, groupData] in Object.entries((packageTree[type] && packageTree[type].groups) || {})" :key="`${type}-${groupName}`">
                    <div x-show="type !== 'go' && groupName === 'default' && expandedTypes[type] === true" x-cloak class="mb-2">
                        <button 
                            @click.prevent="toggleGroup(type, groupName)"
                            type="button"
                            class="w-full flex items-center justify-between px-3 py-2 bg-blue-50 hover:bg-blue-100 rounded transition-colors text-left mb-1">
                            <div class="flex items-center space-x-2">
                                <i :class="expandedGroups[`${type}:${groupName}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-blue-600 text-xs"></i>
                                <span class="text-xs font-medium text-blue-700" x-text="groupName"></span>
                                <span class="text-xs text-blue-600" x-text="`(${groupData.count} packages)`"></span>
                            </div>
                        </button>
                        <div x-show="expandedGroups[`${type}:${groupName}`] === true" x-cloak class="ml-2">
                            <template x-for="[pkgName, pkgGroup] in Object.entries(groupData.packages || {})" :key="pkgName">
                                <div x-show="packageMatchesSearch(pkgName, '') || (pkgGroup.versions && pkgGroup.versions.some(p => packageMatchesSearch(pkgName, p.version)))">
                                    <div x-data="{ pkgName: pkgName, pkgGroup: pkgGroup, pkgPath: pkgName }">
                                        <button 
                                            @click.prevent="togglePackage(type, pkgPath)"
                                            type="button"
                                            class="w-full flex items-center justify-between px-4 py-2 bg-gray-25 hover:bg-gray-50 rounded transition-colors text-left">
                                            <div class="flex items-center space-x-2 flex-1">
                                                <span class="text-sm font-medium text-gray-700" x-text="formatGoPackageName(pkgName, type) || 'N/A'"></span>
                                                <span class="text-xs text-gray-500" x-text="`(${pkgGroup.versions && pkgGroup.versions.length ? pkgGroup.versions.length : 0} version${(pkgGroup.versions && pkgGroup.versions.length !== 1) ? 's' : ''})`"></span>
                                            </div>
                                            <i :class="expandedPackages[`${type}:${pkgPath}`] === true ? 'ti ti-chevron-down' : 'ti ti-chevron-right'" class="icon text-gray-400 text-xs"></i>
                                        </button>
                                        <div x-show="expandedPackages[`${type}:${pkgPath}`] === true" x-cloak class="ml-4 mt-1 space-y-1">
                                            <!-- Use the same version rendering pattern from above, but with full metadata for flat groups -->
                                            <template x-for="pkg in pkgGroup.versions" :key="pkg.id || (pkg.version + (pkg.architecture ? `:${pkg.architecture}` : ''))">
                                                <div x-show="packageMatchesSearch(pkgName, pkg.version)" 
                                                     class="px-4 py-2 bg-white border border-gray-100 rounded hover:bg-gray-50 transition-colors" 
                                                     :class="{'cursor-pointer': (type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata}"
                                                     @click="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && loadNPMMetadata(pkg, $event)) || (type === 'pypi' && pkg.name && pkg.version && !pkg.loadingMetadata && loadPyPIMetadata(pkg, $event)) || (type === 'go' && pkg.name && pkg.version && !pkg.loadingMetadata && loadGoMetadata(pkg, $event)) || (type === 'apk' && pkg.name && pkg.version && !pkg.loadingMetadata && loadAPKMetadata(pkg, $event))">
                                                    <div class="flex items-center justify-between">
                                                        <div class="flex items-center space-x-4 flex-1 flex-wrap">
                                                            <span class="text-sm font-medium text-gray-900" x-text="pkg.version || 'N/A'"></span>
                                                            <span x-show="pkg.version === 'N/A'" class="text-xs text-gray-400 italic" x-text="`ID: ${pkg.id ? (pkg.id.split('/').pop() || pkg.id) : (pkg.version || 'N/A')}`"></span>
                                                            <span class="text-xs text-gray-500" x-text="formatBytes(pkg.size)"></span>
                                                            <span x-show="pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                                <i class="ti ti-check icon mr-1"></i>
                                                                <span>Cached</span>
                                                            </span>
                                                            <span x-show="!pkg.cached" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                                <i class="ti ti-cloud icon mr-1"></i>
                                                                <span>Available</span>
                                                            </span>
                                                            <span x-show="pkg.access_count > 0" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800" x-text="`${pkg.access_count}x`"></span>
                                                            <span x-show="pkg.cached_at" class="text-xs text-gray-400" x-text="formatDate(pkg.cached_at)"></span>
                                                            <span x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.loadingMetadata" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                                <i class="ti ti-loader icon mr-1 animate-spin"></i>
                                                                <span>Loading...</span>
                                                            </span>
                                                            <span x-show="(type === 'npm' && pkg.cached && !pkg.loadingMetadata && !pkg.metadata) || ((type === 'pypi' || type === 'go' || type === 'apk') && pkg.name && pkg.version && !pkg.loadingMetadata && !pkg.metadata)" class="text-xs text-gray-400 italic">(click to load metadata)</span>
                                                        </div>
                                                    </div>
                                                    <!-- Full metadata for flat groups -->
                                                    <div x-show="pkg.architecture" class="mt-1">
                                                        <span class="text-xs text-gray-500">Architecture<span x-show="type === 'apk' && pkg.architecture.includes(',')">s</span>: </span>
                                                        <span class="text-xs text-gray-700 font-mono" x-text="pkg.architecture"></span>
                                                    </div>
                                                    <div x-show="pkg.license || (pkg.metadata && pkg.metadata.license) || (type === 'apt' ? false : pkgGroup.license)" class="mt-1">
                                                        <span class="text-xs text-gray-500">License: </span>
                                                        <span class="text-xs text-gray-700" x-text="pkg.license || (pkg.metadata && pkg.metadata.license ? (typeof pkg.metadata.license === 'string' ? pkg.metadata.license : (pkg.metadata.license && pkg.metadata.license.type ? pkg.metadata.license.type : '')) : '') || (type === 'apt' ? '' : (pkgGroup.license || ''))"></span>
                                                    </div>
                                                    <div x-show="type !== 'apt' && (pkg.description || (pkg.metadata && pkg.metadata.description))" class="mt-1">
                                                        <span class="text-xs text-gray-600" x-text="pkg.description || (pkg.metadata && pkg.metadata.description) || ''"></span>
                                                    </div>
                                                    <div x-show="(pkg.dependencies && Array.isArray(pkg.dependencies) && pkg.dependencies.length > 0) || (pkg.metadata && pkg.metadata.dependencies && ((Array.isArray(pkg.metadata.dependencies) && pkg.metadata.dependencies.length > 0) || (typeof pkg.metadata.dependencies === 'object' && !Array.isArray(pkg.metadata.dependencies) && Object.keys(pkg.metadata.dependencies).length > 0)))" class="mt-1">
                                                        <span class="text-xs text-gray-500">Depends: </span>
                                                        <span class="text-xs text-gray-600" x-text="(pkg.dependencies && Array.isArray(pkg.dependencies)) ? pkg.dependencies.join(', ') : (pkg.metadata && pkg.metadata.dependencies ? (Array.isArray(pkg.metadata.dependencies) ? pkg.metadata.dependencies.join(', ') : (typeof pkg.metadata.dependencies === 'object' && !Array.isArray(pkg.metadata.dependencies) ? Object.keys(pkg.metadata.dependencies).join(', ') : '')) : '')"></span>
                                                    </div>
                                                    <div x-show="(type === 'npm' || type === 'pypi' || type === 'go' || type === 'apk') && pkg.metadata" class="mt-2 pt-2 border-t border-gray-200 space-y-1">
                                                        <div x-show="(type === 'npm' || type === 'pypi') && pkg.metadata && pkg.metadata.author" class="text-xs">
                                                            <span class="text-gray-500">Author: </span>
